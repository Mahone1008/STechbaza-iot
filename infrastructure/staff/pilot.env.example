# Copy to .env.pilot. Generate distinct random secrets; never commit the result.
CUSTOMER_HOST=app.your-domain.example
STAFF_PUBLIC_URL=https://your-host.your-tailnet.ts.net
MIGRATOR_DB_PASSWORD=
CUSTOMER_DB_PASSWORD=
STAFF_DB_PASSWORD=
CUSTOMER_JWT_SECRET=
STAFF_JWT_SECRET=
ACCOUNT_KEY_SECRET=
STAFF_DIAGNOSTICS_SECRET=
# Until SMTP is connected, registration/invitation sending fails explicitly.
MAIL_DELIVERY_MODE=disabled
MAIL_FROM=KERUMO <access@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Configure the existing Dynamic Security gateway before physical activation.
CONTROLLER_BROKER_ADMIN_HOST=controller-gateway
CONTROLLER_BROKER_ADMIN_PORT=1884
CONTROLLER_BROKER_ADMIN_PASSWORD=
CONTROLLER_MQTT_PUBLIC_HOST=
CONTROLLER_MQTT_PUBLIC_PORT=8884
