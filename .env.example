# Локальні параметри розробки TechBaza.
# Скопіюйте цей файл у .env і змініть значення за потреби.
# Файл .env не потрапляє в Git.

POSTGRES_DB=techbaza
POSTGRES_USER=techbaza
POSTGRES_PASSWORD=change_me_for_local_development

# MQTT command channel. Для production потрібні TLS, credentials та ACL.
MQTT_COMMAND_TOPIC_TEMPLATE=techbaza/devices/{device_uid}/commands
MQTT_PUBLISH_TIMEOUT_SECONDS=3


# Remote Command reliability worker (V3.5 local deployment)
COMMAND_RETRY_INTERVAL_SECONDS=10
COMMAND_RELIABILITY_POLL_SECONDS=2
COMMAND_RELIABILITY_BATCH_SIZE=100
COMMAND_RESULT_TIMEOUT_SECONDS=120

# Authentication. Для production використовуйте випадковий secret >= 32 символів.
AUTH_ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_for_local_development
# Keep this key stable across JWT signing rotations. On upgrade, use the old JWT secret.
ACCOUNT_KEY_SECRET=replace_with_a_separate_long_random_account_key
ACCOUNT_KEY_PREVIOUS_SECRETS=[]
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_ISSUER=techbaza
AUTH_TOKEN_AUDIENCE=techbaza-api

# Браузерний клієнт. HTTP та Secure=false — тільки loopback локальної розробки.
# Публічний стенд: точні HTTPS origins, AUTH_COOKIE_SECURE=true і власний JWT secret.
AUTH_BROWSER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
AUTH_RATE_WINDOW_SECONDS=300
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_SESSION_IP_LIMIT=120

# Email confirmation and invitations. Configure SMTP before public registration.
# local is allowed only with loopback AUTH_BROWSER_ORIGINS and writes private files.
MAIL_DELIVERY_MODE=disabled
MAIL_PUBLIC_URL=http://127.0.0.1:3000
MAIL_LOCAL_DIRECTORY=.local/mail
MAIL_FROM=KERUMO <access@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# Давність показань незалежна від heartbeat/online.
TELEMETRY_STALE_AFTER_SECONDS=120
