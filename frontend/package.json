{
  "name": "kerumo-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ./src/lib/api/openapi.json --output ./src/lib/api/schema.d.ts --alphabetize",
    "api:verify": "node ./scripts/verify-openapi.mjs",
    "check": "npm run api:verify && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "typescript": "^5"
  }
}
