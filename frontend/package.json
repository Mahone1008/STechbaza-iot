{
  "name": "kerumo-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "check:budget": "node ./scripts/check-build-budget.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ./src/lib/api/openapi.json --output ./src/lib/api/schema.d.ts --alphabetize",
    "api:verify": "node ./scripts/verify-openapi.mjs",
    "test:unit": "vitest run && node --test scripts/eslint-config.test.mjs",
    "test:browser": "playwright test",
    "test:browser:live": "playwright test --config playwright.live.config.ts",
    "browser:install": "playwright install chromium",
    "check": "npm run api:verify && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test:browser",
    "format:check": "node ./scripts/check-format.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "next": "16.3.6",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.3.6": {
      "fast-glob": "npm:glob@13.0.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "^5",
    "vitest": "5.0.2"
  }
}
